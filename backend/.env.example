# DOCURA backend — environment template.
# Copy to .env and fill in real values. NEVER commit .env.
#
# This file is read by TWO tools, and the prefix says which owns a variable:
#   DOCURA_*    the application (app/core/config.py). An unrecognised DOCURA_*
#               name fails startup, so a typo here is caught rather than ignored.
#   POSTGRES_*  the local database container (docker-compose.yml). The application
#               ignores these; it connects using DOCURA_DATABASE_URL only.

# --- Application -------------------------------------------------------------
# One of: local | test | staging | production
DOCURA_ENVIRONMENT=local
DOCURA_SERVICE_NAME=docura-backend
DOCURA_VERSION=0.1.0
DOCURA_HOST=127.0.0.1
DOCURA_PORT=8000

# --- Logging -----------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
DOCURA_LOG_LEVEL=INFO
# Leave unset to render JSON outside local/test and human-readable logs locally.
# DOCURA_LOG_JSON=true

# --- Database (REQUIRED — no default exists) ---------------------------------
# PostgreSQL DSN. Replace every placeholder below; do not reuse these values.
DOCURA_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@localhost:5433/REPLACE_DB
DOCURA_DB_POOL_SIZE=5
DOCURA_DB_MAX_OVERFLOW=5
DOCURA_DB_CONNECT_TIMEOUT_SECONDS=5.0

# --- HTTP --------------------------------------------------------------------
# JSON array of exact origins. '*' is rejected at startup. The Vite dev server serves
# the frontend on :5173; localhost and 127.0.0.1 are distinct origins to a browser, so
# list both for local development. Narrow this per deployment.
DOCURA_CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DOCURA_MAX_REQUEST_BYTES=1048576

# --- Local PostgreSQL container (docker-compose.yml) -------------------------
# Compose reads this file. Choose your own values; these are placeholders.
# These must agree with the credentials inside DOCURA_DATABASE_URL above.
POSTGRES_USER=REPLACE_USER
POSTGRES_PASSWORD=REPLACE_PASSWORD
POSTGRES_DB=REPLACE_DB
# Host port for the container. 5432 is often already in use.
POSTGRES_HOST_PORT=5433

# --- Authentication ----------------------------------------------------------
# Sessions are opaque server-side records, so there is NO signing key to set.
# NFR-SEC-005 leaves the inactivity period TBD; these are the working defaults.
DOCURA_SESSION_IDLE_TIMEOUT_MINUTES=60
DOCURA_SESSION_ABSOLUTE_TIMEOUT_HOURS=24
DOCURA_PASSWORD_MIN_LENGTH=12
# How long a password-reset link stays usable (FR-ACC-005). Short by design:
# until it is spent, the link is a bearer credential for the account.
DOCURA_PASSWORD_RESET_TOKEN_TTL_MINUTES=30
DOCURA_AUTH_RATE_LIMIT_ATTEMPTS=10
DOCURA_AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- Document vault ----------------------------------------------------------
# Where uploaded originals are written. A relative path resolves against the
# process working directory, so this file names no machine-specific location; a
# deployment points it at its own volume. The directory is created on startup with
# owner-only permissions, and must NOT be inside a directory the web server serves.
DOCURA_DOCUMENT_STORAGE_ROOT=var/documents
# FR-UPL-003 requires the limits be stated in advance. No approved document fixes a
# number, so both of these are assumptions and are configurable for that reason.
DOCURA_MAX_DOCUMENT_BYTES=10485760
DOCURA_MAX_DOCUMENTS_PER_UPLOAD=5

# --- Chatbot LLM (intent understanding only) ---------------------------------
# The chatbot works with NO LLM configured (deterministic intent provider). To enable a
# real LLM for intent classification ONLY, set all three of PROVIDER, MODEL, and API_KEY.
# The LLM is an understanding layer: it never becomes the source of truth, accesses the
# database/documents, approves, fills, or submits — and any failure falls back to the
# deterministic provider (it never fabricates). Vendor-independent via an OpenAI-compatible
# /chat/completions endpoint (e.g. Gemini's OpenAI-compatible base URL). NEVER commit a key.
#   DOCURA_LLM_PROVIDER: none (default) | openai_compatible
# DOCURA_LLM_PROVIDER=openai_compatible
# DOCURA_LLM_MODEL=gemini-2.0-flash
# DOCURA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# DOCURA_LLM_API_KEY=REPLACE_WITH_YOUR_KEY
# DOCURA_LLM_TIMEOUT_SECONDS=12.0

# --- OCR engine --------------------------------------------------------------
# Production posture is UNCONFIGURED (default): no engine is selected until the S-6
# held-out evaluation reports (D-01/AR-AST-008), so extraction fails honestly rather than
# guessing. `tesseract` is a DEV/EVALUATION opt-in only — NOT an approved production engine.
# DOCURA_OCR_ENGINE=unconfigured

# --- Demo mode ---------------------------------------------------------------
# Backend demo seam (default false). Leave false for normal/production behaviour. This is
# separate from the browser extension's own DEMO_MODE (extension/src/demo.js).
# DOCURA_DEMO_MODE=false

# --- Processing trigger (serverless) -----------------------------------------
# The processing worker (app.worker) is a long-running poll loop that a serverless host
# cannot run. When this secret is set, POST /internal/process is enabled: an out-of-band
# scheduler (e.g. GitHub Actions cron, cron-job.org) calls it periodically with header
#   X-Internal-Secret: <this value>
# and it drains a bounded batch of queued jobs via the SAME process_one path (the queue
# architecture is unchanged). Unset = the endpoint is disabled and fails closed (503).
# Backend-only secret: never a VITE_ variable, never committed. Generate a long random
# value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
# DOCURA_WORKER_TRIGGER_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# --- Tests -------------------------------------------------------------------
# NOT read by the application. The database-backed tests skip unless this names a
# reachable PostgreSQL; they never fall back to a stand-in, so an unset value can
# only produce skips, never a false green run. Point it at a database you are
# willing to have truncated between tests.
#
#   docker compose up -d
#   TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/docura_test pytest
#
# TEST_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@localhost:5433/docura_test
