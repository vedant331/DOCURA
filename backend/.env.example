# DOCURA backend — environment template.
# Copy to .env and fill in real values. NEVER commit .env.
# Every DOCURA_* variable below is read by app/core/config.py.

# --- Application -------------------------------------------------------------
# One of: local | test | staging | production
DOCURA_ENVIRONMENT=local
DOCURA_SERVICE_NAME=docura-backend
DOCURA_VERSION=0.1.0
DOCURA_HOST=127.0.0.1
DOCURA_PORT=8001

# --- Logging -----------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
DOCURA_LOG_LEVEL=INFO
# Leave unset to render JSON outside local/test and human-readable logs locally.
# DOCURA_LOG_JSON=true

# --- Database (REQUIRED — no default exists) ---------------------------------
# PostgreSQL DSN. Replace every placeholder below; do not reuse these values.
DOCURA_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@localhost:5433/REPLACE_DB
DOCURA_DB_POOL_SIZE=5
DOCURA_DB_MAX_OVERFLOW=5
DOCURA_DB_CONNECT_TIMEOUT_SECONDS=5.0

# --- HTTP --------------------------------------------------------------------
# JSON array of exact origins. '*' is rejected at startup.
DOCURA_CORS_ALLOW_ORIGINS=[]
DOCURA_MAX_REQUEST_BYTES=1048576

# --- Local PostgreSQL container (docker-compose.yml) -------------------------
# Compose reads this file. Choose your own values; these are placeholders.
POSTGRES_USER=REPLACE_USER
POSTGRES_PASSWORD=REPLACE_PASSWORD
POSTGRES_DB=REPLACE_DB
# Host port for the container. 5432 is often already in use.
DOCURA_PG_HOST_PORT=5433
