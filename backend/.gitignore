.venv/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# The document vault's local storage. Real identity documents land here during
# development; nothing under it may ever reach version control.
var/

# Raw personal documents staged for S-6 evaluation intake. Real identity documents
# (Aadhaar/PAN/marksheets, etc.) land here; they must never reach version control.
s6_sources/

# Tesseract DEMO runtime provisioned at build time by build.py (native binary, shared libs,
# tessdata, and OCR pip deps). Fetched during the Vercel build — never committed.
vendor/
